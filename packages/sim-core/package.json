    "bench": "tsx src/bench/queue-bench.ts",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@repo/schemas": "workspace:*"
  }
}